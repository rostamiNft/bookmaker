    ]
   }
  },
  {
   "number": 5,
   "beat": "ep_follow",
   "text": "They walked along the dry streambed, past the willow trees and over the smooth white pebbles. Every few steps, Mia knelt down to look for clues.",
   "image_prompt": "Mia and Nutmeg walking along a dry pebbly streambed between willow trees, Mia carrying a watering can",
   "characters_present": [
    "hero",
    "comp"
   ],
   "image_meta": {
