    ]
   }
  },
  {
   "number": 2,
   "beat": "companion",
   "text": "Mia's best garden friend was Nutmeg, a quick little squirrel, who knew every corner of every flower bed. Together, they knew where the sweetest strawberries hid and which flower opened first in the morning.",
   "image_prompt": "Mia and Nutmeg picking strawberries together in a sunny garden, smiling",
   "characters_present": [
    "hero",
    "comp"
   ],
   "image_meta": {
