  },
  {
   "number": 6,
   "beat": "ep_animals",
   "text": "On the way, they met a family of thirsty ducks waddling in circles. Mia shared the water from the watering can. 'Don't worry,' she told them, 'we're going to fix this.'",
   "image_prompt": "Mia pouring water from a green watering can for a mother duck and ducklings on a dry path, Nutmeg watching kindly",
   "characters_present": [
    "hero",
    "comp"
   ],
