    ]
   }
  },
  {
   "number": 3,
   "beat": "inciting",
   "text": "Then one scorching morning, Mia ran to the bridge and gasped. The stream was gone, and the flowers were wilting. Where water had flowed, there were only dry stones and cracked mud.",
   "image_prompt": "A dry streambed with cracked mud and drooping sunflowers under a hot sun, Mia and Nutmeg looking shocked",
   "characters_present": [
    "hero",
    "comp"
   ],
   "image_meta": {
