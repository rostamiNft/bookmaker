# Copy to .env (never commit .env). All values are optional.
BOOKMAKER_ENV=development            # production hides tracebacks and /api/docs
# BOOKMAKER_DATA_DIR=./data          # projects, SQLite DB, trash, encryption key
# BOOKMAKER_API_TOKEN=change-me      # require "Authorization: Bearer <token>" on /api
# BOOKMAKER_AUTH_MODE=accounts       # none | token | accounts (user logins; first visitor creates the admin)
# BOOKMAKER_SESSION_DAYS=14          # login session lifetime (accounts mode)
# BOOKMAKER_SECRET_KEY=              # Fernet key used to encrypt provider API keys (auto-generated in data dir if empty)
BOOKMAKER_MAX_CONCURRENT_BOOKS=1     # books generated in parallel
BOOKMAKER_MAX_CONCURRENT_IMAGES=2    # parallel image jobs inside one book (offline renderer); external APIs run 1 at a time
BOOKMAKER_MAX_UPLOAD_MB=10
BOOKMAKER_MAX_DISK_GB=20             # refuse new books when project storage exceeds this
BOOKMAKER_RATE_LIMIT_PER_MINUTE=240  # per client IP, 0 = off
BOOKMAKER_ENABLE_OCR=true
# BOOKMAKER_CORS_ORIGINS=http://localhost:5173
# Provider keys can be referenced from the environment in the UI as  env:OPENAI_API_KEY
# OPENAI_API_KEY=
