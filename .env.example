# Copy to .env (never commit .env). All values are optional.
BOOKMAKER_ENV=development            # production hides tracebacks and /api/docs
# BOOKMAKER_DATA_DIR=./data          # projects, SQLite DB, trash, encryption key
# BOOKMAKER_API_TOKEN=change-me      # require "Authorization: Bearer <token>" on /api
# BOOKMAKER_AUTH_MODE=accounts       # none | token | accounts (user logins; first visitor creates the admin)
# BOOKMAKER_SESSION_DAYS=14          # login session lifetime (accounts mode)
# BOOKMAKER_SECRET_KEY=              # Fernet key used to encrypt provider API keys (auto-generated in data dir if empty)
BOOKMAKER_MAX_CONCURRENT_BOOKS=1     # books generated in parallel
BOOKMAKER_MAX_CONCURRENT_IMAGES=2    # parallel image jobs inside one book (offline renderer); external APIs run 1 at a time
BOOKMAKER_MAX_UPLOAD_MB=10
BOOKMAKER_MAX_DISK_GB=20             # refuse new books when project storage exceeds this
BOOKMAKER_RATE_LIMIT_PER_MINUTE=240  # per client IP, 0 = off
BOOKMAKER_ENABLE_OCR=true
# BOOKMAKER_CORS_ORIGINS=http://localhost:5173
# Provider keys can be referenced from the environment in the UI as  env:OPENAI_API_KEY
# OPENAI_API_KEY=

# ---------------------------------------------------------------- database / queue
# Empty = bundled SQLite file (single process). Set to run several workers/containers:
#   BOOKMAKER_DATABASE_URL=postgresql://bookmaker:secret@postgres:5432/bookmaker
# (driver: pg8000, pure Python, BSD-3)
# BOOKMAKER_DATABASE_URL=
# BOOKMAKER_DB_POOL_SIZE=5
# Optional: Redis for shared worker locks across machines (redis-py, MIT).
# Without it the locks are in-process, which is correct for a single container.
# BOOKMAKER_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- mail (password reset)
# Without an SMTP server, reset links are handed to an administrator instead of mailed.
# BOOKMAKER_SMTP_HOST=smtp.example.com
# BOOKMAKER_SMTP_PORT=587
# BOOKMAKER_SMTP_USER=
# BOOKMAKER_SMTP_PASSWORD=
# BOOKMAKER_SMTP_FROM=bookmaker@example.com
# BOOKMAKER_SMTP_STARTTLS=true
# BOOKMAKER_PUBLIC_URL=https://bookmaker.example.com   # base URL used in e-mails

# ---------------------------------------------------------------- single sign-on (OIDC)
# Works with Keycloak, Authentik, Zitadel, Okta, Entra ID, Google, ...
# Redirect URI to register: https://your-host/api/auth/sso/callback
# BOOKMAKER_OIDC_ISSUER=https://keycloak.example.com/realms/bookmaker
# BOOKMAKER_OIDC_CLIENT_ID=bookmaker
# BOOKMAKER_OIDC_CLIENT_SECRET=
# BOOKMAKER_OIDC_REDIRECT_URI=https://bookmaker.example.com/api/auth/sso/callback
# BOOKMAKER_OIDC_SCOPE=openid email profile
# BOOKMAKER_OIDC_LABEL=Company login
# BOOKMAKER_OIDC_AUTO_CREATE=true                       # create an account on first login
# BOOKMAKER_OIDC_ROLE_CLAIM=roles                       # claim holding admin/user (optional)
